    prerequisiteNodeIds: []
    isWaitingInput: 0
  - nodeId: S01-C010
    questionExample: 自動推論
    text: "（異物とは……毒か。それが皮下にとどまって脂質から糖へ分解する代謝を阻害している）\n（ならば）"
    keywords: []
    keywordMatchType: 0
